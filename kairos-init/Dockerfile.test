# Flavor smoke test image for kairos-init.
#
# Consumed by .github/workflows/_build-flavors.yaml. Each cell
# verifies that kairos-init can convert the given BASE_IMAGE into a
# bootable Kairos rootfs (with the requested MODEL / TRUSTED_BOOT /
# PROVIDER / FIPS knobs) and that `kairos-init validate` passes on
# the result. No ISO, no push.
#
# The kairos-init binary itself is not built here; it is copied from
# the per-arch dist/linux-<TARGETARCH>/ directory the caller workflow
# unpacks into the build context, matching the consumer shape used
# by the production kairos-init/Dockerfile.

ARG BASE_IMAGE=ubuntu:24.04

FROM scratch AS kairos-init-bin
ARG TARGETARCH
COPY dist/linux-${TARGETARCH}/kairos-init /kairos-init

FROM ${BASE_IMAGE} AS default
ARG MODEL=generic
ARG TRUSTED_BOOT=false
ARG PROVIDER_NAME
ARG PROVIDER_VERSION
ARG VERSION=v0.0.1
ARG FIPS=false
ARG VALIDATE=true

COPY --from=kairos-init-bin /kairos-init /kairos-init
RUN /kairos-init -l debug -m "${MODEL}" -t "${TRUSTED_BOOT}" \
      --provider "${PROVIDER_NAME}" \
      --provider-"${PROVIDER_NAME}"-version "${PROVIDER_VERSION}" \
      --version "${VERSION}" \
      "$(if [ "${FIPS}" = "true" ]; then echo "--fips"; fi)"
RUN if [ "${VALIDATE}" = 'true' ]; then /kairos-init validate -t "${TRUSTED_BOOT}"; fi
RUN rm /kairos-init
