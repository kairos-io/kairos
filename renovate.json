{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Brussels",
  "pinDigests": false,
  "commitMessagePrefix": ":arrow_up: ",
  "reviewers": [
    "team:maintainers"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "custom.nvidia-jetson-linux"
      ],
      "extractVersion": "(?:^|/)r(?<version>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)(?:/|$)"
    }
  ],
  "customDatasources": {
    "nvidia-jetson-linux": {
      "defaultRegistryUrlTemplate": "https://docs.nvidia.com/jetson/archives/index.html",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pkg/stages/steps_install\\.go$/"
      ],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+l4tVersion = getEnvOrDefault\\(\\\"L4T_VERSION\\\", \\\"(?<currentValue>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)\\\"\\)"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "AGENT_VERSION\\s*:=\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "kairos-io/kairos-agent"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "IMMUCORE_VERSION\\s*:=\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "kairos-io/immucore"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "KCRYPT_DISCOVERY_CHALLENGER_VERSION\\s*:=\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "kairos-io/kcrypt-discovery-challenger"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "PROVIDER_KAIROS_VERSION\\s*:=\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "kairos-io/provider-kairos"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "EDGEVPN_VERSION\\s*:=\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "mudler/edgevpn"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "INSTALLER_VERSION\\s*:=\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "packageNameTemplate": "kairos-io/kairos-installer"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>ghcr\\.io/kairos-io/hadron):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
