{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "never",
  "schedule": [
    "after 11pm every weekday",
    "before 7am every weekday",
    "every weekend"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Brussels",
  "commitMessagePrefix": ":arrow_up: ",
  "reviewers": [
    "team:maintainers"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false
    },
    {
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true
    },
    {
      "description": "The v2 line of bubbles and bubbletea is published as charm.land/bubbles/v2 and charm.land/bubbletea/v2, so github.com/charmbracelet/<pkg>/v2 does not resolve. See #4472 and #4473.",
      "matchDatasources": [
        "go"
      ],
      "matchDepNames": [
        "github.com/charmbracelet/bubbles",
        "github.com/charmbracelet/bubbletea"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "edgevpn v0.35.4 added api/spa.go with a //go:embed of react-ui/dist, which is gitignored upstream and absent from the published module zip, so every version from v0.35.4 on fails to compile for consumers. See #4464 and mudler/edgevpn#1080.",
      "matchDatasources": [
        "go"
      ],
      "matchDepNames": [
        "github.com/mudler/edgevpn"
      ],
      "allowedVersions": "<0.35.4"
    },
    {
      "description": "kubo v0.41.0 pulls cockroachdb/swiss, which go:linknames into runtime internals that Go 1.27 removed. The pin and its reason live in the Dockerfile. See #4509.",
      "matchFileNames": [
        "examples/bundle/Dockerfile"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/.*.ya?ml/"
      ],
      "matchStrings": [
        "quay.io/kairos/auroraboot:(?<currentValue>[a-zA-Z0-9_.-]+)",
        "auroraboot_version:\\s*[\\\"']?(?<currentValue>[a-zA-Z0-9_.-]+)[\\\"']?"
      ],
      "depNameTemplate": "quay.io/kairos/auroraboot",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+[A-Z_][A-Z0-9_]*\\s*=\\s*\"[^:\"]+:(?<currentValue>[^\"\\s]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^provider/internal/role/p2p/kubevip\\.go$/"
      ],
      "matchStrings": [
        "DefaultKubeVIPVersion\\s*=\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kube-vip/kube-vip",
      "versioningTemplate": "semver"
    }
  ]
}
