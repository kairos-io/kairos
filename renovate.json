{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "never",
  "schedule": [
    "after 11pm every weekday",
    "before 7am every weekday",
    "every weekend"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Brussels",
  "commitMessagePrefix": ":arrow_up: ",
  "reviewers": [
    "team:maintainers"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false
    },
    {
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true
    },
    {
      "description": "kubo v0.41.0's transitive dep github.com/cockroachdb/swiss only supports Go < 1.27; do not auto-bump the bundle's golang base image until that dependency adds support.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "examples/bundle/Dockerfile"
      ],
      "matchDepNames": [
        "golang"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/.*.ya?ml/"
      ],
      "matchStrings": [
        "quay.io/kairos/auroraboot:(?<currentValue>[a-zA-Z0-9_.-]+)",
        "auroraboot_version:\\s*[\\\"']?(?<currentValue>[a-zA-Z0-9_.-]+)[\\\"']?"
      ],
      "depNameTemplate": "quay.io/kairos/auroraboot",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+[A-Z_][A-Z0-9_]*\\s*=\\s*\"[^:\"]+:(?<currentValue>[^\"\\s]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^provider/internal/role/p2p/kubevip\\.go$/"
      ],
      "matchStrings": [
        "DefaultKubeVIPVersion\\s*=\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kube-vip/kube-vip",
      "versioningTemplate": "semver"
    }
  ]
}
