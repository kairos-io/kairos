{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "never",
  "schedule": [
    "after 11pm every weekday",
    "before 7am every weekday",
    "every weekend"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Brussels",
  "semanticCommits": "enabled",
  "reviewers": [
    "team:maintainers"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false
    },
    {
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true
    },
    {
      "description": "The v2 line of bubbles and bubbletea is published as charm.land/bubbles/v2 and charm.land/bubbletea/v2, so github.com/charmbracelet/<pkg>/v2 does not resolve. See #4472 and #4473.",
      "matchDatasources": [
        "go"
      ],
      "matchDepNames": [
        "github.com/charmbracelet/bubbles",
        "github.com/charmbracelet/bubbletea"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "edgevpn v0.35.4 added api/spa.go with a //go:embed of react-ui/dist, which is gitignored upstream and absent from the published module zip, so every version from v0.35.4 on fails to compile for consumers. See #4464 and mudler/edgevpn#1080.",
      "matchDatasources": [
        "go"
      ],
      "matchDepNames": [
        "github.com/mudler/edgevpn"
      ],
      "allowedVersions": "<0.35.4"
    },
    {
      "description": "kubo v0.41.0 pulls cockroachdb/swiss, which go:linknames into runtime internals that Go 1.27 removed. The pin and its reason live in the Dockerfile. See #4509.",
      "matchFileNames": [
        "examples/bundle/Dockerfile"
      ],
      "enabled": false
    },
    {
      "description": "AuroraBoot kept patch updates on automerge in its own repository, unlike the rest of this one.",
      "matchFileNames": [
        "auroraboot/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "auroraboot/go.mod"
      ],
      "matchUpdateTypes": [
        "minor",
        "digest"
      ],
      "groupName": "auroraboot go dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "auroraboot/ui/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "auroraboot frontend dependencies"
    },
    {
      "description": "typescript-eslint caps its typescript peer dependency at <6.1.0, so TypeScript 6 and 7 cannot be installed next to it and `npm run lint` fails outright. Hold typescript on 5.x until typescript-eslint publishes a release that admits it. See kairos-io/AuroraBoot#674 and typescript-eslint/typescript-eslint#10940.",
      "matchFileNames": [
        "auroraboot/ui/**"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6"
    },
    {
      "matchFileNames": [
        "auroraboot/go.mod"
      ],
      "matchDepNames": [
        "github.com/urfave/cli/v3"
      ],
      "enabled": false
    },
    {
      "groupName": "repositories",
      "matchPackageNames": [
        "/^quay.io/kairos/packages*/"
      ]
    },
    {
      "versioning": "regex:^(?<major>\\d{12})-git(?<patch>[a-f0-9]{8})-repository\\.yaml$",
      "matchPackageNames": [
        "/^quay.io/kairos/packages*/"
      ]
    },
    {
      "description": "openSUSE Leap 42.x is the EOL 2017 line, older than 15.x and 16.x, but Renovate reads 42 as the newest version. Keep it out. See kairos-io/AuroraBoot#923.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "opensuse/leap"
      ],
      "allowedVersions": "<42"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.github/workflows/.*.ya?ml/",
        "/internal/testartifacts/.*\\.go$/"
      ],
      "matchStrings": [
        "quay.io/kairos/auroraboot:(?<currentValue>[a-zA-Z0-9_.-]+)",
        "AuroraBootVersion = \\\"(?<currentValue>[a-zA-Z0-9_.-]+)\\\"",
        "auroraboot_version:\\s*[\\\"']?(?<currentValue>[a-zA-Z0-9_.-]+)[\\\"']?"
      ],
      "depNameTemplate": "quay.io/kairos/auroraboot",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+[A-Z_][A-Z0-9_]*\\s*=\\s*\"[^:\"]+:(?<currentValue>[^\"\\s]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^provider/internal/role/p2p/kubevip\\.go$/"
      ],
      "matchStrings": [
        "DefaultKubeVIPVersion\\s*=\\s*\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kube-vip/kube-vip",
      "versioningTemplate": "semver"
    },
    {
      "description": "zizmor-action runs whichever zizmor release it is given, and a new release can bring new audits, so the version is pinned in the workflow.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/zizmor\\.yaml$/"
      ],
      "matchStrings": [
        "ZIZMOR_VERSION:\\s*'(?<currentValue>[0-9.]+)'"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zizmorcore/zizmor",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "kairos-init/README.md's Quick example pins the image in a fenced code block, so the dockerfile manager (which only scans files literally named Dockerfile/Containerfile) never sees it.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^kairos-init/README\\.md$/"
      ],
      "matchStrings": [
        "quay.io/kairos/kairos-init:(?<currentValue>[a-zA-Z0-9_.-]+)"
      ],
      "depNameTemplate": "quay.io/kairos/kairos-init",
      "datasourceTemplate": "docker"
    },
    {
      "description": "images/Dockerfile defaults KAIROS_INIT to a tag of quay.io/kairos/kairos-init. Builds that do not override it (reusable-factory.yaml without a dockerfile_path, a plain docker build) get that version, so it has to follow the releases.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG KAIROS_INIT=(?<currentValue>v[a-zA-Z0-9_.-]+)"
      ],
      "depNameTemplate": "quay.io/kairos/kairos-init",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^auroraboot/image-assets/luet-(amd64|arm64)\\.yaml$/"
      ],
      "matchStrings": [
        "\\s*#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)?\\s+reference:\\s(?<currentValue>.*?)\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^auroraboot/internal/builder/auroraboot/constants\\.go$/"
      ],
      "matchStrings": [
        "defaultKairosInitVersion\\s*=\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/kairos/kairos-init"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^auroraboot/ui/src/pages/ArtifactBuilder\\.tsx$/"
      ],
      "matchStrings": [
        "//\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*baseImage:\\s*\"[^\"]+:(?<currentValue>[^\"]+)\"",
        "//\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*const\\s+\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/_auroraboot-tests\\.yaml$/"
      ],
      "matchStrings": [
        "quay\\.io/kairos/ubuntu:(?<currentValue>24\\.04-core-amd64-generic-v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "quay.io/kairos/ubuntu",
      "versioningTemplate": "regex:^24\\.04-core-amd64-generic-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
